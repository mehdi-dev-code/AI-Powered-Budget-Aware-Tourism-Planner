# Copy this file to .env and fill in the values. Never commit or share .env (it is in .gitignore).
GEMINI_API_KEY=your-key-here
# Password for the Admin area in the app (add hotels, create owner logins, refresh data). Admin stays locked without it.
ADMIN_PASSWORD=choose-a-long-password
# Optional: choose another model from AI Studio
# GEMINI_MODEL=gemini-3.8-flash
